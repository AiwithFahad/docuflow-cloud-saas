# DocuFlow Cloud — environment configuration example
# Copy to ".env" and fill in your own values. NEVER commit real secrets.

APP_NAME="DocuFlow Cloud"
APP_URL=http://localhost:8000
APP_ENV=production
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=docuflow_cloud
DB_USER=docuflow
DB_PASS=change-me-placeholder

MAIL_FROM=no-reply@example.com

TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=7
MAX_UPLOAD_BYTES=52428800

# Payment gateway (optional) — leave blank to use manual payment recording
PAYMENT_GATEWAY=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
